# Example repo profile. Copy to .clagentic/loadout/profile.yaml in your repository, or
# run `loadout-profile init` to draft one from the file tree. Commit it to the base branch:
# review reads it from the base revision, so it applies to changes made after it lands.
# Reference: docs/repo-profile.md

# released-tool: the tree ships to people outside your deployment.
# internal:      the tree stays inside your deployment.
class: released-tool

# Paths that are not what ships, or that follow a different class. A later match wins.
paths:
  "tests/fixtures/**": {class: internal}
  ".agent-state/**": {class: internal}

# Values this repository forbids, on top of your deployment's own denial list
# (review.repo_profile.deny in the user-level config). Released-tool paths only.
deny:
  names: [some-agent-name]
  hosts: [host.example.test]
  users: [some-username]

# Internal paths only: packages of tools this repository consumes. Nothing is checked
# mechanically; the list is given to the reviewer, who judges whether code reaches into
# their internal modules instead of their documented interface.
# tool_packages: [some_tool]

# Risk posture, read only by gates from the merge base (never shown to a planner or builder).
# A missing, unrecognised or older-than-180-days value is the worst case and is reported by
# `loadout-profile check`. confirmed_at is the date you last checked these answers.
exposure: local_or_ci_only      # internet | internal_authenticated | local_or_ci_only
data: public_or_none            # regulated_or_customer | internal | public_or_none
visibility: public              # public | private
merge_control: unrestricted     # code_owner_review_required | review_required | unrestricted
confirmed_at: 2026-10-24

# The commands `clagentic-loadout test run` uses. Each is an argv list run without a shell
# from the repository root, and must write a JUnit XML report to the {junit} path. Every
# key is optional. {base} (impacted only) is replaced by the commit SHA of --base, or of
# the default `base` below; the file paths given to `files` are appended to its argv.
test:
  full: [python3, -m, pytest, "--junitxml={junit}"]
  files: [python3, -m, pytest, "--junitxml={junit}"]
  impacted: [./select-and-run-tests, --since, "{base}", --junit, "{junit}"]
  base: origin/main
